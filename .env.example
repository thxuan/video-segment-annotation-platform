# Run python tools/prepare_demo.py to create .env with random local passwords.
# This file contains placeholders only. Never commit the real .env.
POSTGRES_DB=annotation
POSTGRES_USER=annotation
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55433
APP_DATABASE_URL=postgresql+psycopg://annotation:replace-with-a-local-password@127.0.0.1:55433/annotation
APP_VIDEO_DIR=storage/videos
APP_MAX_UPLOAD_MB=512
APP_COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080","http://localhost:8000","http://127.0.0.1:8000"]
APP_ALLOW_DEMO_SEED=true
APP_DEMO_PASSWORD=replace-with-a-demo-password
